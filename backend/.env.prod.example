# Production. `backend/create_example_env.sh --prod` copies this to
# `backend/.env` on the VPS — which is the name `deploy.sh setup --prod` and the
# systemd unit it installs both read. Fill it in there.
#
# Nothing loads it on its own; there is no `load_dotenv` anywhere. It reaches
# the process through `docker run --env-file`, which is what deploy.sh does, or
# through `uvicorn --env-file backend/.env`, and through nothing else.
#
# `.env.example` is the *development* set and documents every variable the code
# reads, most of which you should leave alone. This file is the shorter, harder
# question: what a real deployment must decide. Every uncommented line below
# has to be answered; the commented ones are correct defaults, shown so you know
# they were considered rather than missed.
#
# Keep the filled-in copy off the box's world-readable paths and out of git.
# Only `.env.prod.example` is tracked; `create_example_env.sh` writes the copy
# mode 600.


# --- the database ----------------------------------------------------------

# Neon, and the pooled endpoint specifically. The code keys off the `-pooler`
# marker to switch off prepared statements, and derives the checkpointer's
# direct endpoint by stripping it — so handing it the direct URL means the
# pooling logic never engages.
#
# The role is the reduced-privilege `interview_lm_app`, not the owner. It owns
# three schemas with deliberately opposite lifecycles (ADR-0010):
# `interview_lm_core` is permanent and holds Evidence, `interview_lm_content`
# is rebuildable by re-import, `interview_lm_graph` is the LangGraph
# checkpointer and is disposable outside the resumption window.
#
# There are no migrations and no alembic: `create_core` and `create_content`
# apply their DDL idempotently on every boot.
#
# The database is not on this VPS on purpose. It holds Evidence, and Evidence
# outlives any one deployment (ADR-0003) — a database that lives on the box it
# serves is a database that dies when you rebuild the box.
DATABASE_URL=postgresql://interview_lm_app:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require


# --- the model -------------------------------------------------------------

# The platform key. The Interviewer grades with it and the embedder ingests
# with it, so one credential rather than two, and every provider call still
# passes through the one chokepoint where it can be metered (SPEC-0005).
#
# A deployment with no platform key is a real deployment — BYOK Candidates
# bring their own. It is not a reason to serve scripted text that looks like a
# model reply, which is why the stand-in has to be asked for by name and never
# stands in for a missing key.
OPENROUTER_API_KEY=sk-or-v1-...


# --- embeddings ------------------------------------------------------------

# ⚠️  The two that fail quietly if you forget them.
#
# `hashing` is the default — a lexical stand-in with no dependencies, and what
# the test suite runs on. Left at the default in production, ingest still
# succeeds and Related Topics is simply noise, with no error anywhere to say
# so. Worse against a Corpus already embedded by the paid route: two
# incompatible spaces in one table.
#
# Changing this later is not a config edit. The vectors in
# `interview_lm_content` were written by whatever wrote them, and moving to
# another provider means re-embedding them (`scripts/reset_embeddings.py`).
EMBEDDING_PROVIDER=openrouter

# The paid route is refused unless this is said out loud (ADR-0016): a
# deployment must decide to spend, never start by default. Without it, boot
# fails with `PaidProviderRefused` — which is the honest failure, and is also
# why you cannot reach the paid route by accident.
EMBEDDING_ALLOW_PAID=1


# --- the operator console --------------------------------------------------

# The console is authenticated by this and nothing else. Generate one:
#
#   openssl rand -hex 32
#
# Never a default, never reused from another environment.
OPERATOR_TOKEN=


# --- key custody (ADR-0013) ------------------------------------------------
#
# ⚠️  Generate ONCE. Store it somewhere that is not this box.
#
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# This wraps every BYOK Candidate's data key. It is not a rotating secret: it
# is the only thing that can read what Candidates attached.
#
# Losing it or regenerating it does not break the deployment, which is what
# makes it dangerous — the service starts fine and every stored key is
# permanently undecryptable, rows intact and nothing able to read them. The
# failure surfaces at the moment somebody starts a Session, not at boot.
# `rotate_kek` re-wraps without touching ciphertext, which is how this is
# changed on purpose rather than by accident.
#
# Any random string works. Fernet wants url-safe base64 of exactly 32 bytes,
# and anything that is not already that shape is hashed to it by a fixed
# mapping — so the same secret always yields the same key across restarts.
#
# Do NOT set BYOK_KEK_EPHEMERAL here. It mints a key per process, which means
# losing every attached key at every restart.
BYOK_KEK=


# --- serving the surface ---------------------------------------------------
#
# Two shapes, and the first is simpler. Pick one.
#
# SAME ORIGIN (recommended on a VPS, and what we run). Caddy serves the built
# `dist/` and proxies `/v1` to this process. There is then one origin, no CORS to
# configure, and neither this variable nor the surface's `VITE_API_URL` is set
# at all — which is SPEC-0000 §7's original design. ADR-0020 only reversed it
# because a CDN forced a second origin. Leave this empty.
#
# SPLIT ORIGIN. The surface is on a CDN and reaches this API cross-origin. Name
# the origin exactly — scheme and host, no trailing path. `*` is refused at
# startup rather than warned about: this API sends credentials, a wildcard with
# credentials is rejected by every browser, and silently dropping the
# credentials would break authentication in a way that only appears once
# authentication exists.
#
# The surface must then also be built with VITE_API_URL pointing here. It is
# baked in at BUILD time, not read at runtime — a built surface should know
# which API it was built against.
ALLOWED_ORIGINS=


# --- identity (ADR-0026) ---------------------------------------------------
#
# Both already default to these values, so they are here to be seen rather than
# set. Uncomment only to point at a development Gatehouse.
#
# The audience is our tenant slug. It is permanent, and it is what stops a
# token minted for another product being accepted here.
#
# Not an environment variable, and the thing most likely to look like a CORS
# bug: the surface's origin must be registered with Gatehouse for the
# `interview-lm` tenant, or sign-in fails with the token never arriving.
# GATEHOUSE_ISSUER=https://auth.buildspacelabs.com
# GATEHOUSE_AUDIENCE=interview-lm


# --- uploaded documents ----------------------------------------------------
#
# R2. All four, on every production deployment.
#
# The code permits local disk and development uses it, so this is a choice
# rather than a constraint — and it is made for the reason ADR-0003 keeps the
# database off the box. Since ISSUE-0033 the stored document is the only copy
# of what a Candidate handed over; a retry re-embeds from it rather than asking
# for the file again. On local disk that copy is one directory on one machine,
# and a rebuild that misses the volume loses material nothing else holds.
# Keeping Neon off the box while keeping its source material on it is the
# inconsistency this closes.
#
# Half-configured is refused at the point of use, naming what is missing,
# rather than surfacing as a credentials error inside a Candidate's upload. An
# unreachable bucket refuses the upload (`document_store_unavailable`) rather
# than quietly falling back to a disk this deployment said it was not using —
# a document accepted and not kept is found weeks later, by a retry.

# The bucket name. `MODEL_BUCKET` is read as a fallback for model artifacts;
# with EMBEDDING_PROVIDER=openrouter there are no weights to publish, so this
# one is the whole of it.
CONTENT_BUCKET=interview-lm-content

# Where R2 serves the S3 API. The account id is on the R2 page of the
# Cloudflare dashboard. Nothing here runs on AWS — boto3 is simply how R2 is
# spoken to, and there is no region variable because R2 signs everything `auto`.
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com

# An R2 API token with Object Read & Write on that bucket — its id and secret.
# Passed to the client explicitly, so a host that happens to carry AWS keys in
# its environment does not quietly become the store.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. The key prefix within the bucket; defaults to `notebooks`.
# CONTENT_PREFIX=notebooks


# --- deliberately absent ---------------------------------------------------
#
# GRAPH_DATABASE_URL   derived by dropping `-pooler` from DATABASE_URL's host.
#                      Set it only if the direct endpoint is named differently.
# SURFACE_DIR          the Dockerfile sets it. The mount is skipped when the
#                      directory is absent rather than failing the boot.
# INTERVIEWER_FAKE_MODEL  never in production. It runs the whole loop against a
#                      scripted provider, and every examiner turn comes back as
#                      `SCORE: 0.8 WHY: fine.`
# PORT                 defaults to 8000; the entrypoint honours it if set.
