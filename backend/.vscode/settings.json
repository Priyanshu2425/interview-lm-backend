{
  // This workspace is `backend/`. The surface is a separate repository with
  // its own tooling, so nothing here configures eslint or TypeScript.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.cwd": "${workspaceFolder}",
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.analysis.autoSearchPaths": true,

  // Generated or vendored trees. Excluded from search rather than hidden from
  // the explorer: they are worth opening deliberately and never worth being
  // dredged up by a grep for a symbol name.
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true
  },

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[python]": { "editor.rulers": [88] }
}
