# The documented environment. Copy to `.env` and fill in what you need:
#
#   cp .env.example .env
#
# Nothing reads `.env` on its own — there is no `load_dotenv` anywhere in the
# codebase. It reaches a process only through `uvicorn --env-file .env` or an
# explicit `set -a; . ./.env; set +a`, and that is deliberate: a file that
# loads itself is a file that redirects a test run you did not think was
# configurable.
#
# **Almost all of this is optional locally.** With an empty `.env` the API
# starts, the suite passes, and the whole interview loop runs offline against a
# scripted provider. The variables below are what a *deployment* needs, plus
# the handful worth setting by hand while developing. Each says which it is.


# --- the database ----------------------------------------------------------

# Local Postgres is the default and needs no variable at all: with DATABASE_URL
# unset the application connects to the pgvector container in the README.
#
# ⚠️  Setting this redirects EVERY local run that reads this file at whatever
# it points to. The test suite is pinned to local Postgres in
# `backend/tests/conftest.py` and cannot be redirected by it — but
# `uvicorn --env-file` and everything in `scripts/` can, and will. Point it at
# the shared Neon database only to run an import, then put it back.
#
# Use the *pooled* Neon endpoint: the code detects `-pooler` and switches off
# prepared statements. A URL without a driver (`postgresql://…`, which is what
# every dashboard hands you) is named as psycopg on the way past, so pasting
# one works.
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# The LangGraph checkpointer wants the direct endpoint, not the pooled one. It
# is derived by dropping `-pooler`, so set this only if the direct endpoint is
# named differently.
# GRAPH_DATABASE_URL=

# The shared database's URL, parked out of the way of the variable that takes
# effect. This is the idiom the real `.env` uses: keep the credential written
# down, and copy it into DATABASE_URL for the length of one command.
#   DATABASE_URL="$INTERVIEW_LM_DATABASE_URL" .venv/bin/python scripts/import_corpus.py …
# INTERVIEW_LM_DATABASE_URL=


# --- the model -------------------------------------------------------------

# The provider the Interviewer grades with, and the same key the paid embedder
# uses. Absent, the transport is a deterministic stand-in and everything runs
# offline. Present, calls are real and metered.
# OPENROUTER_API_KEY=

# Forces the stand-in even when a key is present: the whole loop against a
# scripted provider — deterministic, no network, real metering. Every examiner
# turn comes back as `SCORE: 0.8 WHY: fine.` That is the stub, not a bug.
# Worth setting while working on the surface.
# INTERVIEWER_FAKE_MODEL=1


# --- embeddings ------------------------------------------------------------

# What turns a notebook into vectors, and therefore what decides whether
# Related Topics means anything. Chosen explicitly, never inferred — an unknown
# name fails at boot rather than falling back.
#
#   hashing      the default. A lexical stand-in, no dependencies, and what the
#                test suite runs on.
#   openrouter   the paid route (ADR-0019). Real neighbours, metered per call.
#   siglip       the local model. Needs `pip install -e "backend[embeddings]"`
#                — 2.5GB of wheels.
#   http         an embedding endpoint you host.
#
# The shared Corpus in Neon is already embedded in openrouter's space. Changing
# this against that database means re-embedding it (`scripts/reset_embeddings.py`).
# EMBEDDING_PROVIDER=hashing

# A paid provider is refused unless this is said out loud: a deployment must
# decide to spend, never start by default (ADR-0016).
# EMBEDDING_ALLOW_PAID=1


# --- identity (ADR-0026) ---------------------------------------------------

# Gatehouse holds identity; what arrives here is an RS256 bearer token to
# verify against its published keys. Both of these already default to the
# values below, so they are here to be *seen* rather than to be set — override
# the issuer when developing against a local Gatehouse.
#
# The audience is our tenant slug. It is permanent, and it is what stops a
# token minted for another product being accepted here.
# GATEHOUSE_ISSUER=https://auth.buildspacelabs.com
# GATEHOUSE_AUDIENCE=interview-lm


# --- the operator console --------------------------------------------------

# The console is authenticated by this and nothing else, so a deployment
# generates one and never uses a default: `openssl rand -hex 32`.
# OPERATOR_TOKEN=


# --- documents and figures (deployment) ------------------------------------

# Where a Candidate's uploaded documents live. **Not optional on a deployment
# whose filesystem is ephemeral**: since ISSUE-0033 the stored document is the
# only copy of what somebody handed over, and a retry re-embeds from it rather
# than asking for the file again. Without a bucket the documents live in the
# container and are gone at the next deploy.
#
# Unset locally is fine — uploads are refused with `document_store_unavailable`
# rather than quietly kept somewhere they cannot be read back from.
# CONTENT_BUCKET=

# Where R2 serves the S3 API. Nothing here runs on AWS; boto3 is simply how R2
# is spoken to. No region: R2 signs everything `auto`, so it is a constant in
# the code rather than a variable with one legal setting.
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# An R2 API token with Object Read & Write on that bucket. Passed to the client
# explicitly, so a host that happens to carry AWS keys does not quietly become
# the store.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=


# --- key custody (ADR-0013) ------------------------------------------------

# Wraps every BYOK Candidate's data key. A Fernet key — `Fernet.generate_key()`
# — generated once and then left alone: it is not a rotating secret, it is the
# only thing that can read what Candidates attached.
#
# Losing it does not break the deployment. It makes every stored key
# permanently undecryptable, with the rows intact and nothing able to read
# them. `rotate_kek` re-wraps without touching ciphertext, which is how this is
# changed on purpose rather than by accident.
#
# Locally, BYOK_KEK_EPHEMERAL=1 mints one per process instead — fine for a dev
# run, and it discards every stored key when the process exits.
# BYOK_KEK=
# BYOK_KEK_EPHEMERAL=1


# --- serving the surface ---------------------------------------------------

# The origins a browser may call this API from (ADR-0020). Without it the API
# is same-origin only and the surface on Cloudflare Pages cannot reach it at
# all. Not needed when the API serves `dist/` itself.
# ALLOWED_ORIGINS=https://interview-lm.pages.dev

# Where the built surface is, if this API is to serve it. The mount is skipped
# when the directory is absent rather than failing the boot, so a clone with no
# `frontend/` starts fine.
# SURFACE_DIR=frontend/dist
