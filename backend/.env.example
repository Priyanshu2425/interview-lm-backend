# Backend environment. Copy to backend/.env and pass it explicitly:
#
#   .venv/bin/uvicorn interviewer.api.app:app --port 8000 --env-file backend/.env
#
# Nothing in the application calls load_dotenv, so a .env file sitting on disk
# does nothing on its own — uvicorn's --env-file is what reads it. Every
# variable below has a working default; an empty file is a valid deployment.

# --- data -------------------------------------------------------------------

# Postgres. Two schemas with opposite lifecycles live in one database
# (ADR-0010). The default matches the container in the README.
#
# Hosted Postgres needs pgvector (ADR-0017) and nothing else special. A pooled
# endpoint — Neon names it with `-pooler` — is detected, and prepared statements
# are switched off on it: a transaction pooler hands the next statement a
# different backend, so a statement prepared on one is missing on the next.
# Connections are also pre-pinged, because a serverless compute suspends when
# idle and wakes with every pooled connection already dead.
DATABASE_URL=postgresql+psycopg://cortex:cortex@127.0.0.1:55432/cortex

# Where the LangGraph checkpointer connects. Defaults to DATABASE_URL with any
# pooler marker stripped, because that client pipelines and prepares statements
# and belongs on the direct endpoint. Set this only if the direct endpoint is
# not simply the pooled hostname without `-pooler`.
GRAPH_DATABASE_URL=

# maintenance_work_mem for the HNSW index build. Best effort — a small managed
# instance may refuse it, and a slow index build is a much smaller problem than
# a boot that fails. Default: 128MB
INDEX_BUILD_MEM=

# Where `scripts/import_corpus.py` reads a conformant Corpus from, when
# importing one. Not read by the API: every Corpus the API serves is in
# Postgres (SPEC-0006, ISSUE-0037).
# Default: data/corpus.json
CORPUS_PATH=

# --- the model --------------------------------------------------------------

# The platform key. Absent is a real deployment, not a broken one: a BYOK
# Candidate supplies their own key per call.
OPENROUTER_API_KEY=

# Run the whole interview loop against a scripted provider: deterministic, no
# network, real metering. Every examiner turn returns "SCORE: 0.8 WHY: fine."
# Chosen by this explicit flag and never by the absence of a platform key —
# serving scripted text that looks like a model reply should take a decision.
# Set to 1 for local work and for the e2e suite.
INTERVIEWER_FAKE_MODEL=

# --- embedding ---------------------------------------------------------------

# What turns a notebook into vectors. `hashing` is a deterministic lexical
# stand-in with no dependencies: it carries real similarity, costs nothing, and
# is what the test suite runs on. `siglip` is the model that ships. `http` is
# anything speaking the OpenAI embeddings wire format — OpenAI, Azure, a
# Voyage-compatible gateway, or a self-hosted TEI/vLLM server.
#
# Chosen by this flag and never inferred. An unknown name fails at boot rather
# than falling back to the stub, for the same reason INTERVIEWER_FAKE_MODEL is
# explicit: serving stand-in vectors should take a decision.
# `openrouter` is the paid route and uses OPENROUTER_API_KEY below — the same
# key the Interviewer grades with, because ADR-0008 chose one route and
# OpenRouter now serves embeddings as well as chat (ADR-0019).
# Default: hashing
EMBEDDING_PROVIDER=

# Default: google/siglip2-base-patch16-224
EMBEDDING_MODEL=

# A commit sha, never a branch. `main` moving is a different vector space, and
# a notebook embedded in the old one needs re-embedding rather than a shrug —
# which is only possible if what was used is written down. It is: the whole
# identity string lands in notebook.embedding_model.
EMBEDDING_REVISION=

# Must match content.notebook_chunk.embedding, or the API refuses to start.
# Default: 768
EMBEDDING_DIM=

# auto picks cuda, then mps, then cpu. Default: auto
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=
EMBEDDING_TIMEOUT=
EMBEDDING_MAX_RETRIES=

# Extract figures from PDF sources and embed them into the same space as the
# prose (ADR-0017). Off by default: it costs extraction time on every PDF, and
# an embedder with no image tower must not be asked for one.
EMBEDDING_IMAGES=

# The http provider only.
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=

# What a provider bills, in Credits per 1k tokens. A non-zero value is refused
# unless EMBEDDING_ALLOW_PAID=1, because who pays for a BYOK Candidate's ingest
# is an open decision (ADR-0016, proposed). A local model bills nothing, which
# is why the model that ships needs neither of these.
EMBEDDING_CREDITS_PER_1K=
EMBEDDING_ALLOW_PAID=

# --- model artifacts ---------------------------------------------------------

# Weights are published to S3 once (scripts/publish_model.py) and pulled from
# there, so a deployment never reaches huggingface.co and a boot is
# reproducible. Unset, the model is loaded from the hub — fine for a laptop,
# not for a deployment.
MODEL_BUCKET=
MODEL_PREFIX=
MODEL_CACHE_DIR=

# Download and load the model during startup rather than on first use. The
# process reports ready=false at /v1/health until it finishes, so a rolling
# deploy does not route traffic at a host still pulling 1.5GB.
MODEL_WARM_AT_BOOT=

# Where figure bytes live. Falls back to MODEL_BUCKET, and to local disk when
# neither is set. Deleting a notebook deletes its prefix here as well as its
# rows — CASCADE empties the schema and has never heard of the bucket.
CONTENT_BUCKET=
CONTENT_PREFIX=

# --- Related Topics ----------------------------------------------------------

# Nothing to configure. Neighbours are the stored Topic centroids of one Corpus
# compared against each other, written at ingest and never recomputed at request
# time — there is no artifact, no fingerprint and no staleness (ADR-0021).

# --- surfaces ---------------------------------------------------------------

# The operator console is authenticated separately from Candidate access.
# Change this anywhere the console is reachable.
OPERATOR_TOKEN=dev-operator-token

# Origins allowed to call this API from a browser, comma separated. Empty is
# the original deployment and the default: the API mounts the surface at "/",
# so there is one origin and no CORS decision (SPEC-0000 §7). Setting this is
# what reverses that (ADR-0020) — name the surface's origin exactly; "*" is
# refused at startup, because a wildcard with credentials is refused by every
# browser and dropping the credentials would break auth silently.
#
#   ALLOWED_ORIGINS=https://cortex.pages.dev
ALLOWED_ORIGINS=

# What the API mounts at "/". The surface is a build, so this points at dist —
# and a surface change is invisible until `npm run build` in frontend/.
# Default: frontend/dist
SURFACE_DIR=
